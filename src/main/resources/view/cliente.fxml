<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.sysventas.controller.ClienteController">

    <VBox spacing="14"
          AnchorPane.topAnchor="15"
          AnchorPane.leftAnchor="15"
          AnchorPane.rightAnchor="15"
          AnchorPane.bottomAnchor="15">

        <Label text="GESTIÓN DE CLIENTES">
            <font>
                <Font name="System Bold" size="22"/>
            </font>
        </Label>

        <Separator/>

        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="5" right="5" bottom="5" left="5"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints prefWidth="130"/>
                <ColumnConstraints hgrow="SOMETIMES" prefWidth="260"/>
                <ColumnConstraints prefWidth="130"/>
                <ColumnConstraints hgrow="SOMETIMES" prefWidth="260"/>
            </columnConstraints>

            <Label text="DNI:" GridPane.rowIndex="0"/>
            <TextField fx:id="txtDni"
                       promptText="8 dígitos"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"/>

            <Label text="Nombre completo:"
                   GridPane.columnIndex="2"
                   GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombre"
                       promptText="Nombres y apellidos"
                       GridPane.columnIndex="3"
                       GridPane.rowIndex="0"/>

            <Label text="Teléfono:" GridPane.rowIndex="1"/>
            <TextField fx:id="txtTelefono"
                       promptText="9 dígitos"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>
        </GridPane>

        <HBox spacing="10">
            <Button text="REGISTRAR" onAction="#registrar"/>
            <Button text="MODIFICAR" onAction="#modificar"/>
            <Button text="ELIMINAR" onAction="#eliminar"/>
            <Button text="LIMPIAR" onAction="#limpiar"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtFiltro"
                       promptText="Buscar por DNI o nombre"
                       prefWidth="230"/>
            <Button text="BUSCAR" onAction="#buscar"/>
        </HBox>

        <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDni" text="DNI" prefWidth="150"/>
                <TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="350"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="180"/>
            </columns>
        </TableView>

    </VBox>
</AnchorPane>
